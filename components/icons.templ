package components

// Icon renders a named inline SVG icon at a given size in pixels.
templ Icon(name string, size int) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ px(size) } height={ px(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "github":
				<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
				<path d="M9 18c-4.51 2-5-2-7-2"></path>
			case "npm":
				<path d="M2 8.5h20v7H12v1.5H8.75V15.5H2z" fill="currentColor" stroke="none"></path>
			case "dart":
				<path d="M4 3l7-1 9 9-4 4-1 6-7-1-4-4z"></path>
				<path d="M4 3l7 8-1 5-6 2z"></path>
				<path d="M11 11l9 9"></path>
			case "code":
				<path d="m16 18 6-6-6-6"></path>
				<path d="m8 6-6 6 6 6"></path>
			case "globe":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
				<path d="M2 12h20"></path>
			case "database":
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
				<path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
				<path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
			case "sparkles":
				<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path>
			case "terminal":
				<path d="m4 17 6-6-6-6"></path>
				<path d="M12 19h8"></path>
			case "mobile":
				<rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
				<path d="M12 18h.01"></path>
			case "desktop":
				<rect width="20" height="14" x="2" y="3" rx="2" ry="2"></rect>
				<path d="M8 21h8"></path>
				<path d="M12 17v4"></path>
			case "arrow-right":
				<path d="M5 12h14"></path>
				<path d="m12 5 7 7-7 7"></path>
			case "arrow-left":
				<path d="M19 12H5"></path>
				<path d="m12 19-7-7 7-7"></path>
			case "external":
				<path d="M15 3h6v6"></path>
				<path d="M10 14 21 3"></path>
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
			case "check":
				<path d="M20 6 9 17l-5-5"></path>
			case "check-circle":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="m9 12 2 2 4-4"></path>
			case "alert":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 8v4"></path>
				<path d="M12 16h.01"></path>
			case "search":
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			case "sun":
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2"></path>
				<path d="M12 20v2"></path>
				<path d="m4.93 4.93 1.41 1.41"></path>
				<path d="m17.66 17.66 1.41 1.41"></path>
				<path d="M2 12h2"></path>
				<path d="M20 12h2"></path>
				<path d="m6.34 17.66-1.41 1.41"></path>
				<path d="m19.07 4.93-1.41 1.41"></path>
			case "moon":
				<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
			case "menu":
				<path d="M4 6h16"></path>
				<path d="M4 12h16"></path>
				<path d="M4 18h16"></path>
			case "mail":
				<rect width="20" height="16" x="2" y="4" rx="2"></rect>
				<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
			case "send":
				<path d="m22 2-7 20-4-9-9-4Z"></path>
				<path d="M22 2 11 13"></path>
			case "zap":
				<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
			case "rss":
				<path d="M4 11a9 9 0 0 1 9 9"></path>
				<path d="M4 4a16 16 0 0 1 16 16"></path>
				<circle cx="5" cy="19" r="1"></circle>
			case "cog":
				<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path>
				<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z"></path>
			case "folder":
				<path d="M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8l2 2h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2z"></path>
			default:
				<circle cx="12" cy="12" r="10"></circle>
		}
	</svg>
}

// px formats a size integer for use as an SVG dimension attribute.
func px(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var b [12]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		b[i] = '-'
	}
	return string(b[i:])
}
