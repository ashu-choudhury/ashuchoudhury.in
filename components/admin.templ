package components

import (
	"path/filepath"
	"strings"

	"github.com/ashu-choudhury/portfolio/store"
)

// AdminPageMeta carries the admin page title and active nav item.
type AdminPageMeta struct {
	Title  string
	Active string // dashboard | posts | messages | projects | settings
}

// DashboardData is the analytics snapshot for the admin dashboard.
type DashboardData struct {
	TotalViews   int64
	TodayViews   int64
	TopPages     []store.PageViewStat
	Daily        []store.DailyStat
	PostCount    int
	MessageCount int
	ProjectCount int
}

// AdminLayout wraps admin pages in the sidebar shell.
templ AdminLayout(meta AdminPageMeta, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title } — Admin</title>
			<meta name="robots" content="noindex, nofollow"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/htmx-config.js" defer></script>
		</head>
		<body class="admin-body">
			<div class="admin-shell">
				<aside class="admin-sidebar">
					<a class="brand admin-brand" href="/admin">
						<span class="logo"><span>AC</span></span>
						<span>Admin</span>
					</a>
					<nav class="admin-nav" aria-label="Admin">
						<a href="/admin" aria-current={ adminActive(meta.Active, "dashboard") }>
							@Icon("zap", 16)
							Dashboard
						</a>
						<a href="/admin/posts" aria-current={ adminActive(meta.Active, "posts") }>
							@Icon("code", 16)
							Posts
						</a>
						<a href="/admin/messages" aria-current={ adminActive(meta.Active, "messages") }>
							@Icon("mail", 16)
							Messages
						</a>
						<a href="/admin/projects" aria-current={ adminActive(meta.Active, "projects") }>
							@Icon("database", 16)
							Projects
						</a>
						<a href="/admin/files" aria-current={ adminActive(meta.Active, "files") }>
							@Icon("folder", 16)
							Files
						</a>
						<a href="/admin/settings" aria-current={ adminActive(meta.Active, "settings") }>
							@Icon("cog", 16)
							Settings
						</a>
					</nav>
					<div class="admin-sidebar-foot">
						<a href="/" target="_blank" rel="noopener noreferrer">
							@Icon("external", 14)
							View site
						</a>
						<a href="/admin/logout">
							@Icon("arrow-left", 14)
							Log out
						</a>
					</div>
				</aside>
				<div class="admin-main">
					<header class="admin-topbar">
						<h1>{ meta.Title }</h1>
					</header>
					<main class="admin-content">
						@content
					</main>
				</div>
			</div>
		</body>
	</html>
}

func adminActive(active, name string) string {
	if active == name {
		return "page"
	}
	return ""
}

// AdminLogin renders the login screen.
templ AdminLogin(errMsg string) {
	<div class="admin-login-wrap">
		<form class="admin-login" method="post" action="/admin/login" novalidate>
			<span class="logo admin-login-logo"><span>AC</span></span>
			<h1>Admin login</h1>
			<p class="form-note">Sign in to manage the site.</p>
			if errMsg != "" {
				<div class="form-msg err">
					@Icon("alert", 17)
					<div>{ errMsg }</div>
				</div>
			}
			<div class="form-field">
				<label for="username">Username</label>
				<input id="username" name="username" type="text" required autocomplete="username" autofocus/>
			</div>
			<div class="form-field">
				<label for="password">Password</label>
				<input id="password" name="password" type="password" required autocomplete="current-password"/>
			</div>
			<input type="hidden" name="csrf" value={ csrfValue() }/>
			<button class="btn btn-primary" type="submit">Sign in</button>
		</form>
	</div>
}

// AdminDashboard renders the analytics dashboard.
templ AdminDashboard(d DashboardData) {
	<div class="admin-cards">
		<div class="card admin-card">
			<span class="admin-card-label">Total views</span>
			<strong class="admin-card-value">{ fmtCount(d.TotalViews) }</strong>
		</div>
		<div class="card admin-card">
			<span class="admin-card-label">Views today</span>
			<strong class="admin-card-value">{ fmtCount(d.TodayViews) }</strong>
		</div>
		<div class="card admin-card">
			<span class="admin-card-label">Posts</span>
			<strong class="admin-card-value">{ itoa(d.PostCount) }</strong>
		</div>
		<div class="card admin-card">
			<span class="admin-card-label">Messages</span>
			<strong class="admin-card-value">{ itoa(d.MessageCount) }</strong>
		</div>
		<div class="card admin-card">
			<span class="admin-card-label">Projects</span>
			<strong class="admin-card-value">{ itoa(d.ProjectCount) }</strong>
		</div>
	</div>
	<div class="admin-grid-2">
		<div class="card admin-panel">
			<h2>Views — last 14 days</h2>
			@AdminChart(d.Daily)
		</div>
		<div class="card admin-panel">
			<h2>Top pages</h2>
			if len(d.TopPages) == 0 {
				<p class="form-note">No page views yet. Visit the public site to generate some.</p>
			} else {
				<table class="admin-table">
					<thead>
						<tr>
							<th>Page</th>
							<th class="num">Views</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range d.TopPages {
							<tr>
								<td><code>{ p.Path }</code></td>
								<td class="num">{ fmtCount(p.Count) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
}

// AdminChart renders a server-side SVG bar chart (zero JS).
templ AdminChart(daily []store.DailyStat) {
	<div class="chart" role="img" aria-label="Page views per day">
		if len(daily) == 0 {
			<p class="form-note">No data yet.</p>
		} else {
			@templ.Raw(chartSVG(daily))
		}
	</div>
}

// AdminPostsList renders the posts index with actions.
templ AdminPostsList(posts []store.Post) {
	<div class="admin-toolbar">
		<a class="btn btn-primary" href="/admin/posts/new">
			@Icon("send", 15)
			New post
		</a>
	</div>
	if len(posts) == 0 {
		<p class="form-note">No posts yet — create your first one.</p>
	} else {
		<div class="card admin-panel">
			<table class="admin-table">
				<thead>
					<tr>
						<th>Title</th>
						<th>Status</th>
						<th>Published</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, p := range posts {
						<tr>
							<td>
								<a href={ "/admin/posts/" + itoa64(p.ID) + "/edit" }>{ p.Title }</a>
							</td>
							<td>
								if p.Published {
									<span class="chip">published</span>
								} else {
									<span class="chip">draft</span>
								}
							</td>
							<td>{ prettyDate(p.PublishedAt) }</td>
							<td class="admin-row-actions">
								<a class="btn btn-ghost btn-sm" href={ "/admin/posts/" + itoa64(p.ID) + "/edit" }>Edit</a>
								<form method="post" action={ "/admin/posts/" + itoa64(p.ID) + "/delete" } hx-post={ "/admin/posts/" + itoa64(p.ID) + "/delete" } hx-confirm="Delete this post?">
									<input type="hidden" name="csrf" value={ csrfValue() }/>
									<button class="btn btn-ghost btn-sm danger" type="submit">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// AdminPostForm renders the create/edit post form with an HTMX markdown
// preview. p may be nil for new posts; previewHTML is the server-rendered
// markdown shown on first load (kept in sync live as the body is typed).
templ AdminPostForm(p *store.Post, isNew bool, errMsg string, previewHTML string) {
	<div class="card admin-panel">
		if errMsg != "" {
			<div class="form-msg err">
				@Icon("alert", 17)
				<div>{ errMsg }</div>
			</div>
		}
		<form class="contact-form admin-form" method="post" action={ postFormAction(isNew) }>
			<input type="hidden" name="csrf" value={ csrfValue() }/>
			<input type="hidden" name="id" value={ postID(p) }/>
			<div class="form-field">
				<label for="title">Title</label>
				<input id="title" name="title" type="text" required maxlength="160" value={ postTitle(p) }/>
			</div>
			<div class="form-field">
				<label for="slug">Slug (URL)</label>
				<input id="slug" name="slug" type="text" required maxlength="120" value={ postSlug(p) } placeholder="my-first-post"/>
			</div>
			<div class="form-field">
				<label for="summary">Summary</label>
				<input id="summary" name="summary" type="text" maxlength="240" value={ postSummary(p) }/>
			</div>
			<div class="form-field">
				<label for="tags">Tags (comma separated)</label>
				<input id="tags" name="tags" type="text" value={ postTags(p) } placeholder="android, go"/>
			</div>
			<div class="form-field">
				<label for="body">Body (Markdown)</label>
				<textarea
					id="body"
					name="body"
					required
					hx-post="/admin/posts/preview"
					hx-trigger="input changed delay:500ms"
					hx-target="#markdown-preview"
					hx-swap="innerHTML"
					hx-include="closest form"
				>{ postBody(p) }</textarea>
			</div>
			<div class="form-field">
				<label>Preview</label>
				<div id="markdown-preview" class="markdown-preview">
					if previewHTML != "" {
						@templ.Raw(previewHTML)
					} else {
						<p class="form-note">Start typing — the preview updates live as you write.</p>
					}
				</div>
			</div>
			<div class="form-field">
				<label class="check-row">
					<input type="checkbox" name="published" checked={ postPublished(p) }/>
					<span>Published (visible on the site)</span>
				</label>
			</div>
			<div class="admin-form-actions">
				<button class="btn btn-primary" type="submit">Save post</button>
				<a class="btn btn-ghost" href="/admin/posts">Cancel</a>
			</div>
		</form>
	</div>
}

// AdminMessagesList renders the contact inbox.
templ AdminMessagesList(messages []store.Message) {
	if len(messages) == 0 {
		<p class="form-note">No messages yet. Submissions from the contact form appear here.</p>
	} else {
		<div class="card admin-panel">
			<table class="admin-table">
				<thead>
					<tr>
						<th>From</th>
						<th>Message</th>
						<th>Date</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, m := range messages {
						<tr>
							<td>
								<strong>{ m.Name }</strong>
								<br/>
								<span class="form-note">{ m.Email }</span>
							</td>
							<td class="msg-cell">{ m.Body }</td>
							<td>{ prettyDate(m.CreatedAt) }</td>
							<td class="admin-row-actions">
								<form method="post" action={ "/admin/messages/" + itoa64(m.ID) + "/delete" }>
									<input type="hidden" name="csrf" value={ csrfValue() }/>
									<button class="btn btn-ghost btn-sm danger" type="submit">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// AdminProjectsList renders project curation controls.
templ AdminProjectsList(projects []store.Project, msg string, errMsg string) {
	if msg != "" {
		<div class="form-msg ok mb-2">
			@Icon("check-circle", 17)
			<div>{ msg }</div>
		</div>
	}
	if errMsg != "" {
		<div class="form-msg err mb-2">
			@Icon("alert", 17)
			<div>{ errMsg }</div>
		</div>
	}
	<div class="admin-toolbar mb-2" style="display: flex; gap: 1rem; align-items: center;">
		<a class="btn btn-primary" href="/admin/projects/new">
			@Icon("zap", 16)
			New project
		</a>
		<form method="post" action="/admin/projects/sync" class="inline-form">
			<input type="hidden" name="csrf" value={ csrfValue() }/>
			<button class="btn btn-secondary" type="submit">
				@Icon("github", 16)
				Sync Open Source GitHub Repositories
			</button>
		</form>
	</div>
	<p class="form-note mb-2">
		Classification determines which projects are displayed on the public site: <code>original</code> and
		<code>rewritten</code> projects are visible, while <code>clone</code> repositories are hidden by default.
	</p>
	<div class="card admin-panel">
		<table class="admin-table">
			<thead>
				<tr>
					<th>Project</th>
					<th>Classification</th>
					<th>Visible</th>
					<th>Featured</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, p := range projects {
					<tr>
						<td>
							<strong>{ p.Name }</strong>
							<br/>
							<span class="form-note">{ p.Language } · updated { shortDate(p.PushedAt) }</span>
						</td>
						<td>
							<form method="post" action={ "/admin/projects/" + p.Slug + "/classify" } class="inline-form">
								<input type="hidden" name="csrf" value={ csrfValue() }/>
								<select name="classification" hx-post={ "/admin/projects/" + p.Slug + "/classify" } hx-trigger="change" hx-include="closest form" hx-swap="none">
									<option value="original" selected={ string(p.Classification) == "original" }>original</option>
									<option value="rewritten" selected={ string(p.Classification) == "rewritten" }>rewritten</option>
									<option value="clone" selected={ string(p.Classification) == "clone" }>clone</option>
								</select>
							</form>
						</td>
						<td>
							<form method="post" action={ "/admin/projects/" + p.Slug + "/visible" } class="inline-form">
								<input type="hidden" name="csrf" value={ csrfValue() }/>
								<input type="hidden" name="visible" value={ boolStr(!p.Visible) }/>
								<button class="btn btn-ghost btn-sm" type="submit">{ visibleLabel(p.Visible) }</button>
							</form>
						</td>
						<td>
							<form method="post" action={ "/admin/projects/" + p.Slug + "/featured" } class="inline-form">
								<input type="hidden" name="csrf" value={ csrfValue() }/>
								<input type="hidden" name="featured" value={ boolStr(!p.Featured) }/>
								<button class="btn btn-ghost btn-sm" type="submit">{ featuredLabel(p.Featured) }</button>
							</form>
						</td>
						<td class="admin-row-actions">
							<a class="btn btn-ghost btn-sm" href={ "/admin/projects/" + p.Slug + "/edit" }>Edit</a>
							<form method="post" action={ "/admin/projects/" + p.Slug + "/delete" }>
								<input type="hidden" name="csrf" value={ csrfValue() }/>
								<button class="btn btn-ghost btn-sm danger" type="submit">Delete</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// AdminProjectForm renders the project create/edit form.
templ AdminProjectForm(p *store.Project, isNew bool, errMsg string, previewHTML string) {
	if errMsg != "" {
		<div class="form-msg err">
			@Icon("alert", 17)
			<div>{ errMsg }</div>
		</div>
	}
	<div class="card admin-panel">
		<form class="contact-form admin-form" method="post" action="/admin/projects/save" enctype="multipart/form-data">
			<input type="hidden" name="csrf" value={ csrfValue() }/>
			<input type="hidden" name="is_new" value={ boolStr(isNew) }/>
			
			<div class="form-row">
				<div class="form-field">
					<label for="name">Project Name *</label>
					<input id="name" name="name" type="text" value={ projectVal(p, "name") } required/>
				</div>
				<div class="form-field">
					<label for="slug">URL Slug *</label>
					<input id="slug" name="slug" type="text" value={ projectVal(p, "slug") } placeholder="auto-generated if empty"/>
				</div>
			</div>

			<div class="form-field">
				<label for="tagline">Tagline</label>
				<input id="tagline" name="tagline" type="text" value={ projectVal(p, "tagline") } placeholder="Short one-line elevator pitch"/>
			</div>

			<div class="form-field">
				<label for="summary">Summary</label>
				<textarea id="summary" name="summary" rows="2" placeholder="Brief project summary">{ projectVal(p, "summary") }</textarea>
			</div>

			<div class="form-field">
				<label for="description">Full Description (Markdown)</label>
				<textarea id="description" name="description" rows="12" placeholder="Write full project details in Markdown..." hx-post="/admin/posts/preview" hx-trigger="keyup changed delay:300ms" hx-target="#preview-output">{ projectVal(p, "description") }</textarea>
			</div>

			<div class="form-field">
				<label>Markdown Preview</label>
				<div id="preview-output" class="markdown-preview">
					if previewHTML != "" {
						@templ.Raw(previewHTML)
					} else {
						<p class="muted">Live markdown preview will appear here as you type...</p>
					}
				</div>
			</div>

			<div class="form-row">
				<div class="form-field">
					<label for="language">Primary Language</label>
					<input id="language" name="language" type="text" value={ projectVal(p, "language") } placeholder="e.g. Kotlin, Go, Rust"/>
				</div>
				<div class="form-field">
					<label for="year">Year</label>
					<input id="year" name="year" type="text" value={ projectVal(p, "year") } placeholder="e.g. 2026"/>
				</div>
				<div class="form-field">
					<label for="classification">Classification</label>
					<select id="classification" name="classification">
						<option value="original" selected={ projectVal(p, "classification") == "original" }>original</option>
						<option value="rewritten" selected={ projectVal(p, "classification") == "rewritten" }>rewritten</option>
						<option value="clone" selected={ projectVal(p, "classification") == "clone" }>clone</option>
					</select>
				</div>
			</div>

			<div class="form-field">
				<label for="repo_url">GitHub Repository URL (Optional)</label>
				<input id="repo_url" name="repo_url" type="url" value={ projectVal(p, "repo_url") } placeholder="https://github.com/username/repo"/>
			</div>

			<div class="form-field">
				<label for="stack">Tech Stack Chips (comma-separated)</label>
				<input id="stack" name="stack" type="text" value={ projectStackVal(p) } placeholder="Kotlin, Compose, Android, NDK"/>
			</div>

			<div class="form-field">
				<label for="features">Key Features (one per line)</label>
				<textarea id="features" name="features" rows="4" placeholder="High-performance async I/O engine&#10;Zero allocation memory buffer">{ projectFeaturesVal(p) }</textarea>
			</div>

			<div class="form-field">
				<label for="attachment">Optional File Attachment (Uploads to storage/persisted/www/projects/[slug]/)</label>
				<input id="attachment" name="attachment" type="file"/>
				if p != nil && len(p.Links) > 0 {
					<p class="form-note mt-1">Existing Links & Attachments:</p>
					<ul>
						for _, l := range p.Links {
							<li><a href={ l.URL } target="_blank" rel="noopener noreferrer"><code>{ l.Label }</code> ({ l.URL })</a></li>
						}
					</ul>
				}
			</div>

			<div class="form-row mt-2">
				<label class="check-row">
					<input type="checkbox" name="visible" checked={ projectBool(p, "visible") }/>
					<span>Visible on public site</span>
				</label>
				<label class="check-row">
					<input type="checkbox" name="featured" checked={ projectBool(p, "featured") }/>
					<span>Featured on home page</span>
				</label>
			</div>

			<div class="admin-form-actions mt-3">
				<button class="btn btn-primary" type="submit">Save Project</button>
				<a class="btn btn-ghost" href="/admin/projects">Cancel</a>
			</div>
		</form>
	</div>
}

// AdminSettingsForm renders the site settings editor.
templ AdminSettingsForm(siteTitle, siteDesc string, saved bool) {
	if saved {
		<div class="form-msg ok">
			@Icon("check-circle", 17)
			<div>Settings saved.</div>
		</div>
	}
	<div class="card admin-panel">
		<form class="contact-form admin-form" method="post" action="/admin/settings">
			<input type="hidden" name="csrf" value={ csrfValue() }/>
			<div class="form-field">
				<label for="site-title">Site title</label>
				<input id="site-title" name="site_title" type="text" value={ siteTitle }/>
			</div>
			<div class="form-field">
				<label for="site-desc">Meta description</label>
				<textarea id="site-desc" name="site_desc">{ siteDesc }</textarea>
			</div>
			<div class="admin-form-actions">
				<button class="btn btn-primary" type="submit">Save settings</button>
			</div>
		</form>
	</div>
}

// AdminPreview renders the markdown preview fragment.
templ AdminPreview(html string) {
	@templ.Raw(html)
}

// FileInfo is a file/folder item in the file manager.
type FileInfo struct {
	Name      string
	RelPath   string
	PublicURL string
	Size      string
	IsDir     bool
	ModTime   string
}

// AdminFilesView renders the file manager interface for storage/persisted/www.
templ AdminFilesView(relDir string, files []FileInfo, msg, errMsg string) {
	if msg != "" {
		<div class="form-msg ok">
			@Icon("check-circle", 17)
			<div>{ msg }</div>
		</div>
	}
	if errMsg != "" {
		<div class="form-msg err">
			@Icon("alert", 17)
			<div>{ errMsg }</div>
		</div>
	}
	<div class="admin-grid-2">
		<div class="card admin-panel">
			<h2>Upload file</h2>
			<form class="admin-form" method="post" action="/admin/files/upload" enctype="multipart/form-data">
				<input type="hidden" name="csrf" value={ csrfValue() }/>
				<input type="hidden" name="dir" value={ relDir }/>
				<div class="form-field">
					<label for="file">Choose file</label>
					<input id="file" name="file" type="file" required/>
				</div>
				<button class="btn btn-primary" type="submit">
					@Icon("send", 15)
					Upload file
				</button>
			</form>
		</div>
		<div class="card admin-panel">
			<h2>New directory</h2>
			<form class="admin-form" method="post" action="/admin/files/mkdir">
				<input type="hidden" name="csrf" value={ csrfValue() }/>
				<input type="hidden" name="dir" value={ relDir }/>
				<div class="form-field">
					<label for="folder_name">Directory name</label>
					<input id="folder_name" name="folder_name" type="text" placeholder="e.g. downloads" required/>
				</div>
				<button class="btn btn-ghost" type="submit">Create directory</button>
			</form>
		</div>
	</div>
	<div class="card admin-panel mt-2">
		<div class="file-breadcrumbs">
			<a href="/admin/files"><strong>storage/persisted/www</strong></a>
			if relDir != "" {
				<span> / { relDir }</span>
			}
		</div>
		if len(files) == 0 {
			<p class="form-note mt-2">No files or subdirectories found in this location.</p>
		} else {
			<table class="admin-table mt-2">
				<thead>
					<tr>
						<th>Name</th>
						<th>Public URL</th>
						<th>Size</th>
						<th>Modified</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					if relDir != "" {
						<tr>
							<td colspan="5">
								<a href={ "/admin/files?dir=" + parentDir(relDir) }>
									@Icon("arrow-left", 14) <strong>.. (Parent Directory)</strong>
								</a>
							</td>
						</tr>
					}
					for _, f := range files {
						<tr>
							<td>
								if f.IsDir {
									<a href={ "/admin/files?dir=" + f.RelPath }>
										@Icon("folder", 16)
										<strong>{ f.Name }/</strong>
									</a>
								} else {
									<a href={ f.PublicURL } target="_blank" rel="noopener noreferrer">
										@Icon("code", 16)
										{ f.Name }
									</a>
								}
							</td>
							<td>
								if !f.IsDir {
									<code>{ f.PublicURL }</code>
								} else {
									<span class="muted">—</span>
								}
							</td>
							<td>{ f.Size }</td>
							<td>{ f.ModTime }</td>
							<td class="admin-row-actions">
								if !f.IsDir {
									<a class="btn btn-ghost btn-sm" href={ f.PublicURL } target="_blank" rel="noopener noreferrer">Open</a>
								}
								<form method="post" action="/admin/files/delete">
									<input type="hidden" name="csrf" value={ csrfValue() }/>
									<input type="hidden" name="path" value={ f.RelPath }/>
									<input type="hidden" name="dir" value={ relDir }/>
									<button class="btn btn-ghost btn-sm danger" type="submit">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// ---------------------------------------------------------------------------
// Go helpers used by the admin templates

func csrfValue() string { return csrfToken }

func postFormAction(isNew bool) string {
	if isNew {
		return "/admin/posts/new"
	}
	return "/admin/posts/save"
}

func postID(p *store.Post) string {
	if p == nil {
		return "0"
	}
	return itoa64(p.ID)
}

func postTitle(p *store.Post) string {
	if p == nil {
		return ""
	}
	return p.Title
}

func postSlug(p *store.Post) string {
	if p == nil {
		return ""
	}
	return p.Slug
}

func postSummary(p *store.Post) string {
	if p == nil {
		return ""
	}
	return p.Summary
}

func postTags(p *store.Post) string {
	if p == nil {
		return ""
	}
	return strings.Join(p.Tags, ", ")
}

func postBody(p *store.Post) string {
	if p == nil {
		return ""
	}
	return p.Body
}

func postPublished(p *store.Post) bool {
	return p != nil && p.Published
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func visibleLabel(visible bool) string {
	if visible {
		return "Hide"
	}
	return "Show"
}

func featuredLabel(featured bool) string {
	if featured {
		return "Unfeature"
	}
	return "Feature"
}

func shortDate(iso string) string {
	if len(iso) >= 10 {
		return iso[:10]
	}
	return iso
}

func itoa64(n int64) string {
	return itoa(int(n))
}

func fmtCount(n int64) string {
	if n < 1000 {
		return itoa64(n)
	}
	return itoa64(n/1000) + "k"
}

// csrfToken is set by the handler package at startup; it is rendered into
// every admin form as a hidden field and validated by the server.
var csrfToken = ""

// SetCSRFToken is called once at startup with a random token.
func SetCSRFToken(t string) { csrfToken = t }

func parentDir(rel string) string {
	d := filepath.Dir(rel)
	if d == "." || d == "/" || d == "\\" {
		return ""
	}
	return d
}

func projectVal(p *store.Project, key string) string {
	if p == nil {
		return ""
	}
	switch key {
	case "name":
		return p.Name
	case "slug":
		return p.Slug
	case "tagline":
		return p.Tagline
	case "summary":
		return p.Summary
	case "description":
		return p.Description
	case "language":
		return p.Language
	case "year":
		return p.Year
	case "repo_url":
		return p.RepoURL
	case "classification":
		return string(p.Classification)
	}
	return ""
}

func projectStackVal(p *store.Project) string {
	if p == nil {
		return ""
	}
	return strings.Join(p.Stack, ", ")
}

func projectFeaturesVal(p *store.Project) string {
	if p == nil {
		return ""
	}
	return strings.Join(p.Features, "\n")
}

func projectBool(p *store.Project, key string) bool {
	if p == nil {
		if key == "visible" {
			return true
		}
		return false
	}
	if key == "visible" {
		return p.Visible
	}
	if key == "featured" {
		return p.Featured
	}
	return false
}
