package components

// NotFoundPage renders the styled 404 page.
templ NotFoundPage() {
	<section class="notfound">
		<div class="container">
			<div class="code" aria-hidden="true">404</div>
			<h1>This page went off the grid.</h1>
			<p>The page you're looking for doesn't exist or was moved. Let's get you back to somewhere useful.</p>
			<div class="hero-actions justify-center">
				<a class="btn btn-primary" href="/">Back home</a>
				<a class="btn btn-ghost" href="/projects">View projects</a>
			</div>
		</div>
	</section>
}
