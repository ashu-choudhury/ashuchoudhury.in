# ---------------------------------------------------------------------------
# Freebuff Desktop — portfolio. Copy this file to .env and fill in values.
#   cp .env.example .env
# NEVER commit .env — it contains secrets. This example ships with the repo
# so the configuration surface is fully documented.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Listen port (default 8080).
PORT=8080

# Canonical origin used for canonical URLs, sitemap, RSS and JSON-LD.
# The bare domain is canonical — keep the hosting platform redirecting
# www -> ashuchoudhury.in so canonicals always match the serving host.
SITE_URL=https://ashuchoudhury.in

# SQLite database file. Relative paths resolve from the working directory.
# Persisted data lives under storage/persisted/ by default.
DB_PATH=storage/persisted/portfolio.db

# --- Search engines ------------------------------------------------------
# IndexNow key (e.g. `uuidgen`). When set, the site pings Bing/Yandex/
# Seznam/Naver with the sitemap on every deploy and content change, and
# serves the ownership file at /<key>.txt. Leave empty to disable.
INDEXNOW_KEY=

# --- Admin ---------------------------------------------------------------
ADMIN_USER=admin
# REQUIRED in production — set a long random password:
#   openssl rand -base64 24
ADMIN_PASSWORD=changeme

# --- AI blog generation (optional) ----------------------------------------
# OpenAI-compatible endpoint used by the two-session blog generator
# (strategist picks the next topic from the blog history, then a fresh
# session writes the post). These can also be set in Admin → Settings.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODELS=gpt-4o-mini, gpt-4o, deepseek-chat

# Shared secret for the automatic blog generator endpoint. When set, an
# external scheduler can ping POST /api/ai/generate (with the token) to
# wake the AI: it reviews the published blog history, picks the best next
# topic, writes the full post in a fresh session, and publishes it
# automatically. Also configurable in Admin → Settings.
#   openssl rand -hex 24
# AI_GENERATE_TOKEN=

# --- Optional: S3-compatible backups (AWS S3, Cloudflare R2, MinIO…) ------
# Setting S3_BUCKET enables periodic backups of the SQLite database.
# The database is WAL-checkpointed before upload so backups are consistent.
# On a fresh volume with no local database, the latest backup is restored
# automatically. Nothing is hardcoded — everything comes from the environment.
S3_BUCKET=
S3_REGION=us-east-1
# Custom endpoint for S3-compatible providers (Cloudflare R2, MinIO, …).
# Leave empty for real AWS S3. Path-style requests are used automatically.
S3_ENDPOINT=
# Object key prefix + database object name.
S3_PREFIX=portfolio/
S3_DB_KEY=portfolio.db
# Backup interval in seconds (default 300).
S3_INTERVAL=300
# Set to 1 ONLY for self-hosted MinIO over self-signed TLS.
S3_NO_VERIFY=0

# AWS credentials — used if set; otherwise the default AWS credential
# chain (env, ~/.aws, ECS/EC2 metadata, …) applies.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
